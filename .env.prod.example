# Replace placeholders; use an Atlas database user, not your Atlas login.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gamdow
# Set this to the exact production origin. Do not reuse it for Preview deployments.
APP_URL=https://YOUR_PROJECT.vercel.app
MEDIA_STORAGE=vercel-blob
BLOB_READ_WRITE_TOKEN=YOUR_PRIVATE_BLOB_READ_WRITE_TOKEN

# Server-only. Obtain your own Web API key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Generate a long random value. Must match the deployment for catalog bootstrap.
CRON_SECRET=
STEAM_METADATA_TTL_HOURS=168
STEAM_ACHIEVEMENT_TTL_HOURS=1
# Owned-library preview: MongoDB cache expires after 24h; explicit refresh has a 5min cooldown.
# No NEXT_PUBLIC_ Steam/cron variables. Steam uses the APP_URL OpenID callback.

# Google OAuth Web application credentials (server only).
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
