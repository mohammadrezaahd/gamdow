# Replace placeholders; use an Atlas database user, not your Atlas login.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gamdow
# Set this to the exact production origin. Do not reuse it for Preview deployments.
APP_URL=https://YOUR_PROJECT.vercel.app
MEDIA_STORAGE=vercel-blob
BLOB_READ_WRITE_TOKEN=YOUR_PRIVATE_BLOB_READ_WRITE_TOKEN
