# Local MongoDB Community Server (Compass is the database viewer).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=gamdow_local
APP_URL=http://localhost:3000
MEDIA_STORAGE=local
LOCAL_MEDIA_DIR=.data/uploads

# Server-only. Obtain your own Web API key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Generate a long random value. Must match the deployment for catalog bootstrap.
CRON_SECRET=
STEAM_METADATA_TTL_HOURS=168
STEAM_ACHIEVEMENT_TTL_HOURS=1
